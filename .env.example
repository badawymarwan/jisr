# Copy this file to .env.local (or add these in Vercel > Settings > Environment Variables).
# Without any keys the app runs in DEMO MODE with sample content.

# --- AI brain: notes, quiz, Ask, assignment helper, live notes ---
# Free: https://aistudio.google.com  ("Get API key")
GEMINI_API_KEY=
# Optional: pick a different Gemini model
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest   (tried in order)

# --- Speech-to-text: lectures and live mode ---
# Free: https://console.groq.com  ("API Keys")
GROQ_API_KEY=

# --- Optional paid alternatives ---
# ANTHROPIC_API_KEY=        (Claude; set AI_PROVIDER=anthropic to use it even when a Gemini key is set)
# AI_PROVIDER=anthropic
# OPENAI_API_KEY=           (OpenAI Whisper; used only if there is no Groq key)
